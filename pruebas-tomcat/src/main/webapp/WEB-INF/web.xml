<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
  <display-name>Pruebas FEMPA</display-name>

  <!-- ==============================
         Modo desarrollo de Faces
         ============================== -->

  <!-- Sin esto, Mojarra cachea los recursos estáticos (pago.js, imágenes...)
       durante una semana y los cambios en el JavaScript no se ven al recargar. -->
  <context-param>
    <param-name>jakarta.faces.PROJECT_STAGE</param-name>
    <param-value>Development</param-value>
  </context-param>

  <!-- ==============================
         Weld / CDI
         ============================== -->

    <listener>
        <listener-class>
            org.jboss.weld.environment.servlet.Listener
        </listener-class>
    </listener>


    <!-- ==============================
         Jakarta Faces
         ============================== -->

    <servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>
            jakarta.faces.webapp.FacesServlet
        </servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>


    <!-- ==============================
         Página inicial
         ============================== -->

    <welcome-file-list>
        <welcome-file>dashboard.xhtml</welcome-file>
        <welcome-file>index.xhtml</welcome-file>
    </welcome-file-list>
</web-app>
